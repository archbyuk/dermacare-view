{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FaceFilter MSO",
  "version": "0.0.1",
  "identifier": "com.facfilter.app",
  "build": {
    "frontendDist": "https://dermacare-view.vercel.app/",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "FaceFilter MSO",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "© 2025 FaceFilter. All rights reserved.",
    "category": "Productivity",
    "shortDescription": "페이스필터 시술 관리 프로그램",
    "longDescription": "페이스필터 시술 관리를 위한 데스크톱 애플리케이션입니다."
  }
}
